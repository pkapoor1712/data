			"type": "string",
			"defaultValue": "pksqlserver1.database.windows.net"
		},
		"AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "pksqldatabase"
		},
		"AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "pkadmin"
		},
		"linkedservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pknycstorageacc.dfs.core.windows.net/"
		},
		"linkedservicebronze_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pknycstorageacc.dfs.core.windows.net/"
		},
		"ls_dataset_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pknycstorageacc.dfs.core.windows.net/"
		},
		"ls_sinkcsv_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pknycstorageacc.dfs.core.windows.net/"
		},
		"nycweb_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://d37ci6vzurychx.cloudfront.net/"
		},
		"orderlinkedservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pknycstorageacc.dfs.core.windows.net/"
		},
		"sinklinkedservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pknycstorageacc.dfs.core.windows.net/"
		},
		"sourcedatals_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pknycstorageacc.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureSqlDatabase')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('AzureSqlDatabase_properties_typeProperties_server')]",
					"database": "[parameters('AzureSqlDatabase_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('AzureSqlDatabase_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('AzureSqlDatabase_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/linkedservice')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('linkedservice_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('linkedservice_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/linkedservicebronze')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
