			},
			{
				"name": "country",
				"type": "String"
			},
			{
				"name": "latitude",
				"type": "String"
			},
			{
				"name": "longitude",
				"type": "String"
			},
			{
				"name": "last_updated_timestamp",
				"type": "String"
			}
		]
